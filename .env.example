# Production icin guvenli ornek. Gercek degerleri repo'ya koymayin.
# Secret uretmek icin:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"

NODE_ENV=production
PORT=3750

# Zorunlu: sadece kendi domaininizi yazin. true veya * kullanmayin.
CORS_ORIGIN=https://panel.example.com

# Zorunlu: en az 64 karakter, rastgele.
SESSION_SECRET=replace-with-64-plus-char-random-secret
# Localhost ve HTTPS tunnel beraber calissin diye varsayilan auto.
# Production'da zorlamak isterseniz true, sadece lokal HTTP icin false kullanin.
SESSION_COOKIE_SECURE=auto
# Panel ana sitede iframe olarak gomuluyorsa (FRAME_ANCESTORS dolu) bu deger
# ZORUNLU olarak none olmali; lax cerez cross-site iframe'de hic gonderilmez ve
# giris sonrasi tum istekler 401 doner. none secildiginde Secure de zorunludur.
# Bos birakilirsa: FRAME_ANCESTORS doluysa none, degilse lax.
SESSION_COOKIE_SAMESITE=
# CHIPS. SameSite=none TEK BASINA YETMEZ: Chrome ucuncu taraf cerezleri
# engellediginde gomulu panelde cerez hic gonderilmez (istekte cookie basligi
# olmaz, tarayici Sec-Fetch-Storage-Access: none der). Partitioned ile cerez ust
# seviye siteye gore bolumlenir ve engele takilmaz.
# Bos birakilirsa: SameSite=none + Secure ise acik, degilse kapali.
SESSION_COOKIE_PARTITIONED=

# Zorunlu: master panel icin benzersiz bilgiler.
MASTER_USER=replace-with-private-master-user
MASTER_PASS=replace-with-long-random-master-password

# Opsiyonel global admin. Production'da hardcoded fallback yoktur.
ADMIN_USER=replace-with-private-admin-user
ADMIN_PASS=replace-with-long-random-admin-password
PANEL_AUTH_DISABLED=false

# BetConstruct / Backoffice tokenlari. Mumkunse sadece hosting secret manager'da tutun.
AUTH_TOKEN=
DASHBOARD_AUTH=
BACKOFFICE_AUTH=

# Lynon / tacobahis backoffice gateway. Gercek degerleri repo'ya yazmayin.
# LYNON_PANEL_OTP_SECRET authenticator secret ise otomatik 6 haneli TOTP uretilir.
# Mecbur kalirsaniz LYNON_PANEL_OTP_TOKEN alanina tek seferlik 6 haneli kod yazabilirsiniz.
LYNON_ENABLED=true
LYNON_BACKOFFICE_BASE_URL=https://backoffice.example.com
LYNON_ID_BASE_URL=https://id.example.com
LYNON_SITE_ID=137
LYNON_CURRENCY=TRY
LYNON_PANEL_USERNAME=replace-with-panel-username
LYNON_PANEL_PASSWORD=replace-with-panel-password
LYNON_PANEL_OTP_SECRET=replace-with-base32-totp-secret
LYNON_PANEL_OTP_TOKEN=
LYNON_TRUST_DEVICE=false
LYNON_DEVICE_FINGERPRINT=

# /api/update-token kullanilacaksa zorunlu gibi dusunun; extension/header tarafinda ayni deger gonderilmeli.
TOKEN_UPDATE_SECRET=replace-with-long-random-token-update-secret

# Dokumantasyon arayuzu production'da kapali kalsin.
ENABLE_DOCS=false

# Session suresi: varsayilan 8 saat.
SESSION_TTL_MS=28800000

# Rate limit: production varsayilan 90/dk.
RATE_LIMIT_MAX=90

# SMS kullanilmiyorsa bos birakin.
SEMPICO_TOKEN=
SEMPICO_SENDER_ID=

# Otomatik cekim kontrolu: 0 = kapali.
AUTO_WITHDRAW_INTERVAL_MS=0
# Kalıcı veri katmanı — production'da zorunlu.
# Railway PostgreSQL servisi DATABASE_URL değerini otomatik sağlayabilir.
DATABASE_URL=postgresql://user:password@host:5432/bugs_panel
DATABASE_REQUIRED=true
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Paylaşımlı session ve API cache — production'da zorunlu.
# Railway Redis servisi REDIS_URL değerini otomatik sağlayabilir.
REDIS_URL=redis://default:password@host:6379
REDIS_REQUIRED=true
REDIS_KEY_PREFIX=bugs-panel
REDIS_CONNECT_TIMEOUT_MS=10000

# PostgreSQL aktifken JSON dosyalarına ayrıca yansıtmak için true yapın.
# Normal production kullanımında false kalmalı.
JSON_MIRROR_WRITES=false

# ─── Anlik rapor Telegram botu ────────────────────────────────────────────
# Kasa ozeti, yatirim, cekim, bakiye duzeltmesi ve bonus verilisleri anlik
# olarak bu sohbete dusar. BOS BIRAKILIRSA BOT HIC CALISMAZ — varsayilan bir
# sohbet uydurmak, kasa raporunu yanlis yere gondermek olur.
TELEGRAM_RAPOR_CHAT_ID=
# Olay taramasi sikligi (ms).
TELEGRAM_RAPOR_ARALIK_MS=60000
# Kasa ozeti sikligi (ms). 0 = ozet kapali, olay bildirimleri devam eder.
TELEGRAM_RAPOR_OZET_MS=3600000

# ─── Hedef bakiye kilidi ──────────────────────────────────────────────────
# 100 FS Telegram Katil Bonusu alan oyuncunun bakiyesi esigi GECTIGINDE bahis
# yetkisi kapanir. Cekim ve yatirim ASLA kapatilmaz.
HEDEF_BAKIYE_KILIDI=1
# 1 = karar verilir ve denetime yazilir ama Lynon'a YAZILMAZ. Uretimde ilk gun
# bununla izleyin.
HEDEF_BAKIYE_KURU=0
HEDEF_BAKIYE_ESIGI=2500
# Kapatilacak kisit: casinoBet veya sportsBet.
HEDEF_BAKIYE_KISITI=casinoBet
# Kural yalnizca bu kampanya/bonus alicilarina uygulanir.
TELEGRAM_FS_KAMPANYA_ID=1885
TELEGRAM_FS_BONUS_ID=1687
# Kac gun geriye bakilir; gecmise donuk toplu kisitlamayi engeller.
HEDEF_BAKIYE_GUN=3
HEDEF_BAKIYE_ARALIK_MS=60000
HEDEF_BAKIYE_TUR_LIMITI=40

# ─── Otomatik oyuncu kategorileme ─────────────────────────────────────────
# Seviye esikleri Lynon kategori aciklamalarindan okunur ("[500.000 TL ve
# uzeri]"). Oneriler her zaman uretilir ve panelde gorunur; YAZMA yalnizca
# asagidaki bayrakla acilir. Kategori yazma ucu henuz dogrulanmadi.
OTOMATIK_KATEGORI=0
OTOMATIK_KATEGORI_TUR_LIMITI=25

# ─── Maliyet ayarlari ─────────────────────────────────────────────────────
# Bonus oturumlari uctan tarih filtresiyle cekilemiyor; tek cagri 50'ye kadar
# sirali istek atiyor. Bu onbellek butun cagiranlari (hedef bakiye isi,
# Telegram rapor botu, bonus raporu, kategorileme) tek cekime baglar.
# Dusurmek Lynon istegini ve Railway CPU/trafigini dogrudan artirir.
BONUS_OTURUM_CACHE_MS=180000

# Otomatik atanacak davranis etiketleri (virgullu).
# Varsayilan: highRisk,bonusAvcisi
# "aktif" neredeyse her canli oyuncuya uyar; eklenirse deger merdivenini siler.
# Bos birakilirsa davranis etiketleri yalnizca elle atanir.
# OTOMATIK_DAVRANIS=highRisk,bonusAvcisi

# Rapor onbellek omru. Bugunu iceren pencere kisa (rakam degisiyor),
# tamami gecmiste kalan pencere uzun (veri artik degismez) omurlu.
CANLI_RAPOR_CACHE_MS=60000
GECMIS_RAPOR_CACHE_MS=1800000

# Akis basina Telegram sohbeti. Tanimsiz akis TELEGRAM_RAPOR_CHAT_ID'ye duser;
# o da bossa akis calismaz. Hepsi bossa bot hic calismaz.
TELEGRAM_CHAT_YATIRIM=
TELEGRAM_CHAT_CEKIM_ONAY=
TELEGRAM_CHAT_CEKIM_RED=
TELEGRAM_CHAT_KASA=
TELEGRAM_CHAT_CORRECTION=
TELEGRAM_CHAT_BONUS=

# Lynon site ve saat dilimi baslikları. `sl-timezone` gonderilmezse Lynon
# tarih-only pencereleri UTC sayar ve gunun ilk uc saati rapordan duser.
# Varsayilan Istanbul icin -3; baska dilimdeki bir site icin ezin.
# LYNON_TIMEZONE_OFFSET=-3

# Manuel duzeltme raporu onbellegi. Hem rapor ekrani hem Telegram botu
# ayni cekimi paylasir.
DUZELTME_CACHE_MS=120000

# ─── Telegram cekim butonlari ─────────────────────────────────────────────
# Cekim onay/ret butonlarina basabilecek Telegram kullanici kimlikleri
# (virgullu). BOSSA BUTON HIC EKLENMEZ — para hareketi bir grup uyeliginin
# arkasina birakilamaz.
TELEGRAM_YETKILI_KULLANICILAR=

# Gunde bu sayiya ULASAN cekim talebi otomatik reddedilir.
GUNLUK_CEKIM_ESIGI=3
# Otomatik ret varsayilan olarak KAPALI. Kapaliyken de kural gorunur:
# "bugunku 3. talep" mesajda yazar ve operator tek dokunusla reddeder.
# resolve ucunun istek govdesi bu surumde duzeltildi; once elle dogrulayin.
OTOMATIK_CEKIM_RED=0

# ─── Aylik mutabakat ──────────────────────────────────────────────────────
# Her gun 00:00'da tek sohbete gonderilir. Bossa mutabakat gonderilmez.
TELEGRAM_CHAT_MUTABAKAT=
# 00:00 penceresini kacirmamak icin tolerans (dakika).
MUTABAKAT_PENCERE_DK=10
