# Production icin guvenli ornek. Gercek degerleri repo'ya koymayin.
# Secret uretmek icin:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"

NODE_ENV=production
PORT=3750

# Zorunlu: sadece kendi domaininizi yazin. true veya * kullanmayin.
CORS_ORIGIN=https://panel.example.com

# Zorunlu: en az 64 karakter, rastgele.
SESSION_SECRET=replace-with-64-plus-char-random-secret
# Localhost ve HTTPS tunnel beraber calissin diye varsayilan auto.
# Production'da zorlamak isterseniz true, sadece lokal HTTP icin false kullanin.
SESSION_COOKIE_SECURE=auto
# Panel ana sitede iframe olarak gomuluyorsa (FRAME_ANCESTORS dolu) bu deger
# ZORUNLU olarak none olmali; lax cerez cross-site iframe'de hic gonderilmez ve
# giris sonrasi tum istekler 401 doner. none secildiginde Secure de zorunludur.
# Bos birakilirsa: FRAME_ANCESTORS doluysa none, degilse lax.
SESSION_COOKIE_SAMESITE=
# CHIPS. SameSite=none TEK BASINA YETMEZ: Chrome ucuncu taraf cerezleri
# engellediginde gomulu panelde cerez hic gonderilmez (istekte cookie basligi
# olmaz, tarayici Sec-Fetch-Storage-Access: none der). Partitioned ile cerez ust
# seviye siteye gore bolumlenir ve engele takilmaz.
# Bos birakilirsa: SameSite=none + Secure ise acik, degilse kapali.
SESSION_COOKIE_PARTITIONED=

# Zorunlu: master panel icin benzersiz bilgiler.
MASTER_USER=replace-with-private-master-user
MASTER_PASS=replace-with-long-random-master-password

# Opsiyonel global admin. Production'da hardcoded fallback yoktur.
ADMIN_USER=replace-with-private-admin-user
ADMIN_PASS=replace-with-long-random-admin-password
PANEL_AUTH_DISABLED=false

# BetConstruct / Backoffice tokenlari. Mumkunse sadece hosting secret manager'da tutun.
AUTH_TOKEN=
DASHBOARD_AUTH=
BACKOFFICE_AUTH=

# Lynon / tacobahis backoffice gateway. Gercek degerleri repo'ya yazmayin.
# LYNON_PANEL_OTP_SECRET authenticator secret ise otomatik 6 haneli TOTP uretilir.
# Mecbur kalirsaniz LYNON_PANEL_OTP_TOKEN alanina tek seferlik 6 haneli kod yazabilirsiniz.
LYNON_ENABLED=true
LYNON_BACKOFFICE_BASE_URL=https://backoffice.example.com
LYNON_ID_BASE_URL=https://id.example.com
LYNON_SITE_ID=137
LYNON_CURRENCY=TRY
LYNON_PANEL_USERNAME=replace-with-panel-username
LYNON_PANEL_PASSWORD=replace-with-panel-password
LYNON_PANEL_OTP_SECRET=replace-with-base32-totp-secret
LYNON_PANEL_OTP_TOKEN=
LYNON_TRUST_DEVICE=false
LYNON_DEVICE_FINGERPRINT=

# /api/update-token kullanilacaksa zorunlu gibi dusunun; extension/header tarafinda ayni deger gonderilmeli.
TOKEN_UPDATE_SECRET=replace-with-long-random-token-update-secret

# Dokumantasyon arayuzu production'da kapali kalsin.
ENABLE_DOCS=false

# Session suresi: varsayilan 8 saat.
SESSION_TTL_MS=28800000

# Rate limit: production varsayilan 90/dk.
RATE_LIMIT_MAX=90

# SMS kullanilmiyorsa bos birakin.
SEMPICO_TOKEN=
SEMPICO_SENDER_ID=

# Otomatik cekim kontrolu: 0 = kapali.
AUTO_WITHDRAW_INTERVAL_MS=0
# Kalıcı veri katmanı — production'da zorunlu.
# Railway PostgreSQL servisi DATABASE_URL değerini otomatik sağlayabilir.
DATABASE_URL=postgresql://user:password@host:5432/bugs_panel
DATABASE_REQUIRED=true
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Paylaşımlı session ve API cache — production'da zorunlu.
# Railway Redis servisi REDIS_URL değerini otomatik sağlayabilir.
REDIS_URL=redis://default:password@host:6379
REDIS_REQUIRED=true
REDIS_KEY_PREFIX=bugs-panel
REDIS_CONNECT_TIMEOUT_MS=10000

# PostgreSQL aktifken JSON dosyalarına ayrıca yansıtmak için true yapın.
# Normal production kullanımında false kalmalı.
JSON_MIRROR_WRITES=false
