# ── ZORUNLU ────────────────────────────────────────────────────────────
# Bunlar olmadan panel AÇILMAZ. Eksik yapılandırmayı ilk isteğe kadar
# saklamak, "ayakta ama hiçbir şey kaydedemiyor" durumunu üretir; bu da
# hatasız göründüğü için en geç fark edilen arıza türüdür.

# Oturum jetonları bununla imzalanıyor. Kısa bir değer, jetonun taklit
# edilebilmesi demek: herkes kendini yönetici ilan edebilir.
AFF_SESSION_SECRET=

AFF_ADMIN_KULLANICI=admin
# `npm run ozet -- "parolaniz"` ile üretin. Düz AFF_ADMIN_PAROLA yalnızca
# ilk kurulum kolaylığı için destekleniyor ve açılışta uyarı veriyor.
AFF_ADMIN_PAROLA_OZETI=

# ── ÖNEMLE ÖNERİLEN ────────────────────────────────────────────────────

# Backoffice parolası ve TOTP secret'ı bununla şifreleniyor. TANIMSIZSA
# bağlantı KAYDEDİLEMEZ — sessizce düz metne düşmek yerine reddediyoruz.
# 64 haneli hex, 32 baytlık base64 ya da en az 16 karakterlik parola.
# DİKKAT: değiştirmek, kayıtlı sırları geri döndürülemez şekilde okunamaz
# hale getirir.
AFF_SECRET_KEY=

# Verilerin yazılacağı Postgres. Yoksa diske JSON yazılır; kalıcı diski
# olmayan bir dağıtımda (Railway vb.) her yeniden başlatmada silinir.
DATABASE_URL=

# Ortak portalinde üretilen izlemeli linkin kökü. Boşsa yalnızca doğrudan
# link üretilebilir ve tıklama kırılımı toplanamaz.
AFF_TIKLAMA_TEMEL_URL=https://ortak.ornek.com

# ── İSTEĞE BAĞLI ───────────────────────────────────────────────────────

PORT=4100
LOG_LEVEL=info

# Alt alan adı ya da `x-kiraci` başlığı yoksa kullanılacak kiracı.
VARSAYILAN_KIRACI=varsayilan

# Arayüz ayrı bir kökenden servis ediliyorsa; virgülle ayrılmış.
# Boşsa çapraz köken isteği tamamen kapalı.
AFF_CORS_ORIGIN=

# Oturum süresi (ms). Jeton imzalı olduğu için süresi dolana kadar iptal
# edilemiyor; bu yüzden kısa tutuluyor.
AFF_OTURUM_SURESI_MS=43200000

AFF_RATE_LIMIT=300
AFF_VERI_DIZINI=
AFF_ZAMAN_DILIMI=Europe/Istanbul

POSTBACK_TIMEOUT_MS=8000
POSTBACK_MAX_DENEME=3
TIKLAMA_KAYIT_SINIRI=50000
LYNON_TIMEOUT_MS=30000

# ── WhatsApp CRM oto bonus ─────────────────────────────────────────────
# Bir oyuncunun ILK yatirimi tespit edildiginde CRM'in oto bonus ucuna
# haber verilir; bonusu platforma CRM isler (kayit + gunluk tavan orada).
# Ikisi birden tanimli degilse gonderim tamamen kapali; kural ekrani
# panelde "yapilandirilmamis" olarak gorunur.
AFF_CRM_URL=
# CRM tarafindaki AUTO_BONUS_KEY ile ayni deger.
AFF_CRM_BONUS_ANAHTARI=
